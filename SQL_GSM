-- abertura_ordem_servico
CREATE TABLE abertura_ordem_servico (
  id BIGSERIAL NOT NULL,
  id_ordem_servico BIGINT NOT NULL,
  id_status BIGINT NOT NULL,
  id_usuario_responsavel BIGINT NOT NULL,
  id_usuario_conclusao BIGINT,  -- Quem efetivamente encerrou a OS (pode divergir de id_usuario_responsavel).
  id_usuario_ultima_atualizacao BIGINT NOT NULL,  -- Quem fez a última alteração nesta linha — preenchido pela aplicação a cada UPDATE, usado pelos gatilhos de auditoria.
  data_abertura TIMESTAMP NOT NULL DEFAULT clock_timestamp(),
  data_fechamento TIMESTAMP CHECK (data_fechamento > data_abertura),
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  is_active BOOLEAN NOT NULL DEFAULT true,
  CONSTRAINT abertura_ordem_servico_pkey PRIMARY KEY (id)
);

ALTER TABLE abertura_ordem_servico ADD CONSTRAINT fk_abertura_ordem_servico_id_ordem_servico FOREIGN KEY (id_ordem_servico) REFERENCES ordem_servico (id);
ALTER TABLE abertura_ordem_servico ADD CONSTRAINT fk_abertura_ordem_servico_id_status FOREIGN KEY (id_status) REFERENCES status_ordem_servico (id);
ALTER TABLE abertura_ordem_servico ADD CONSTRAINT fk_abertura_ordem_servico_id_usuario_responsavel FOREIGN KEY (id_usuario_responsavel) REFERENCES usuario (id);
ALTER TABLE abertura_ordem_servico ADD CONSTRAINT fk_abertura_ordem_servico_id_usuario_conclusao FOREIGN KEY (id_usuario_conclusao) REFERENCES usuario (id);
ALTER TABLE abertura_ordem_servico ADD CONSTRAINT fk_abertura_ordem_servico_id_usuario_ultima_atualizacao FOREIGN KEY (id_usuario_ultima_atualizacao) REFERENCES usuario (id);
COMMENT ON COLUMN abertura_ordem_servico.id_usuario_conclusao IS 'Quem efetivamente encerrou a OS (pode divergir de id_usuario_responsavel).';
COMMENT ON COLUMN abertura_ordem_servico.id_usuario_ultima_atualizacao IS 'Quem fez a última alteração nesta linha — preenchido pela aplicação a cada UPDATE, usado pelos gatilhos de auditoria.';
CREATE INDEX idx_abertura_id_ordem_servico ON abertura_ordem_servico USING btree (id_ordem_servico);
CREATE INDEX idx_abertura_id_status ON abertura_ordem_servico USING btree (id_status);
CREATE INDEX idx_abertura_id_usuario_responsavel ON abertura_ordem_servico USING btree (id_usuario_responsavel);
CREATE UNIQUE INDEX uq_abertura_os_ativa ON abertura_ordem_servico USING btree (id_ordem_servico);

