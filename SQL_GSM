--***********************************************************************
-- sessao_atividade
CREATE TABLE sessao_atividade (
  id BIGSERIAL NOT NULL,
  id_atividade BIGINT NOT NULL,
  id_usuario_tecnico BIGINT NOT NULL,
  data_inicio_sessao TIMESTAMP NOT NULL DEFAULT clock_timestamp(),
  data_fim_sessao TIMESTAMP,
  motivo_encerramento VARCHAR(20),
  observacao TEXT,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  is_active BOOLEAN NOT NULL DEFAULT true,
  CONSTRAINT sessao_atividade_pkey PRIMARY KEY (id)
);

ALTER TABLE sessao_atividade ADD CONSTRAINT fk_sessao_atividade_id_atividade FOREIGN KEY (id_atividade) REFERENCES atividade (id);
ALTER TABLE sessao_atividade ADD CONSTRAINT fk_sessao_atividade_id_usuario_tecnico FOREIGN KEY (id_usuario_tecnico) REFERENCES usuario (id);
COMMENT ON TABLE sessao_atividade IS 'Cada linha é um intervalo contínuo de trabalho ("batida de ponto") de um técnico em uma atividade. A soma de (data_fim_sessao - data_inicio_sessao) por atividade é o total de horas de serviço, e cada troca de técnico (pausa + retomada por outra pessoa) fica registrada como sessões separadas.';
CREATE INDEX idx_sessao_atividade_id_atividade ON sessao_atividade USING btree (id_atividade);
CREATE INDEX idx_sessao_atividade_id_usuario_tecnico ON sessao_atividade USING btree (id_usuario_tecnico);
CREATE UNIQUE INDEX uq_sessao_atividade_aberta ON sessao_atividade USING btree (id_atividade);










