ALTER TABLE atividade ADD CONSTRAINT fk_atividade_id_status FOREIGN KEY (id_status) REFERENCES status_atividade (id);
ALTER TABLE atividade ADD CONSTRAINT fk_atividade_id_usuario_conclusao FOREIGN KEY (id_usuario_conclusao) REFERENCES usuario (id);
ALTER TABLE atividade ADD CONSTRAINT fk_atividade_id_usuario_ultima_atualizacao FOREIGN KEY (id_usuario_ultima_atualizacao) REFERENCES usuario (id);
COMMENT ON COLUMN atividade.id_usuario_tecnico IS 'Técnico originalmente designado para a atividade.';
COMMENT ON COLUMN atividade.id_usuario_conclusao IS 'Quem efetivamente concluiu a atividade (pode divergir de id_usuario_tecnico se houve troca de técnico).';
COMMENT ON COLUMN atividade.id_usuario_ultima_atualizacao IS 'Quem fez a última alteração nesta linha — preenchido pela aplicação a cada UPDATE, usado pelos gatilhos de auditoria.';
CREATE INDEX idx_atividade_id_tipo_servico ON atividade USING btree (id_tipo_servico);
